\citation{lukacs2026lab}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Stage~4 simulation output. \textit  {Left}: 30-particle random walk ensemble ($T = 298$\,K, $a = 0.5\,\mu $m). The highlighted particle (black/red trail) is animated live; green dot marks its starting position. \textit  {Right}: Ensemble MSD versus time with theoretical prediction from Eq.~(\ref {eq:msd}) (orange dashed) and linear regression fit (green dotted). This run: $D_{\mathrm  {fit}} = 4.85\times 10^{-13}$\,m$^2$/s, $R^2 = 0.987$.}}{4}{}}
\newlabel{fig:sim}{{3}{4}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Post-simulation analysis. \textit  {Left}: MSD residuals (simulated MSD minus linear fit) versus time. Shaded band shows $\pm 1\sigma = \pm 3.15\,\mu \mathrm  {m}^2$. Scatter increases at late times, consistent with finite ensemble sampling effects. \textit  {Right}: Displacement step distribution (all axes and particles, $n = 47{,}940$) versus expected Gaussian $\mathcal  {N}(0,\sigma )$ with $\sigma = 0.222\,\mu $m. Agreement is consistent with Einstein's assumption (Eq.~\ref {eq:einstein}).}}{4}{}}
\newlabel{fig:analysis}{{4}{4}{}{}{}}
